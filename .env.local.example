# Copy to .env.local and fill in real values. Never commit .env.local.

# Resend — contact form delivery (/api/contact)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_DESTINATION_EMAIL=jon@silicontundrallc.com

# Kit (formerly ConvertKit) — newsletter signup (/api/newsletter)
KIT_API_KEY=kit_xxxxxxxxxxxx
KIT_FORM_ID=0000000

# Booking — Google Appointment Scheduling page (embedded on /book)
# Optional: a default is hardcoded in lib/seo.ts; set this to override per environment.
NEXT_PUBLIC_BOOKING_URL=https://calendar.google.com/calendar/appointments/schedules/xxxxxxxx

# Site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.silicontundrallc.com
